{
  "name": "buildai-tee",
  "displayName": "BuildAI TEE",
  "version": "1.1.0",
  "description": "A simple autofill browser extension that fills forms on supported websites to automate tasks, save time, and reduce manual work.",
  "author": "Build Ai Team",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "prettier": "3.2.4",
    "tailwindcss": "^3.4.18",
    "typescript": "5.3.3"
  },
  "manifest": {
      "host_permissions": [
      "https://*/*",
      "https://api.buildai.gr/*",
      "https://ai.buildai.gr/*"  
    ],
    "background": {
      "service_worker": "background.ts"
    },
    "permissions": [
      "scripting",
      "storage",
      "sidePanel"
    ]
  }
}